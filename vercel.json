{
  "buildCommand": "cd frontend && npm install && npm run build && cp -r dist ../public",
  "installCommand": "pip install --break-system-packages -r requirements.txt",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/jobs/morning", "schedule": "0 6 * * *" },
    { "path": "/api/jobs/evening", "schedule": "30 22 * * *" }
  ]
}
